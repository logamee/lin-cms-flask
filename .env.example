# 复制为 .development.env / .production.env 并填入真实值；该文件提交入库不含敏感信息
# 生成密钥: python -c 'import secrets; print(secrets.token_hex(32))'

SQLALCHEMY_DATABASE_URI = 'sqlite:///../lincmsdev.db'
# SQLALCHEMY_DATABASE_URI = 'mysql+pymysql://user:***@localhost:3306/lincmsdev'
# SQLALCHEMY_DATABASE_URI = 'postgresql://user:***@localhost:5432/lincmsdev'

# 必填：JWT 签名密钥
SECRET_KEY = '<run: python -c "import secrets; print(secrets.token_hex(32))">'

# ---- 以下可选，均有安全默认值 ----

# CORS 来源白名单（逗号分隔）；开发环境默认放行本地 5173 前端 dev server，
# 生产默认空 = 仅同源，前后端不同域名部署时必配
# CORS_ORIGINS = 'https://cms.example.com'

# 限流共享存储；多 worker 生产部署建议指向 redis://，缺省为进程内内存
# RATELIMIT_STORAGE_URI = 'redis://localhost:6379/0'

# 反向代理后设 True，按 X-Forwarded-For 还原真实客户端 IP（限流按真实 IP 计数）
# PROXY_FIX = False
